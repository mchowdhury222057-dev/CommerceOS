{
  "name": "commerceos",
  "private": true,
  "version": "0.1.0",
  "description": "CommerceOS - Multi-Tenant E-Commerce SaaS Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,dashboard,admin,storefront -c blue,green,magenta,yellow \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/store-dashboard\" \"npm run dev --workspace=apps/admin-panel\" \"npm run dev --workspace=apps/storefront\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:dashboard": "npm run dev --workspace=apps/store-dashboard",
    "dev:admin": "npm run dev --workspace=apps/admin-panel",
    "dev:storefront": "npm run dev --workspace=apps/storefront",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run generate --workspace=packages/prisma",
    "prisma:migrate": "npm run migrate:dev --workspace=packages/prisma",
    "seed": "npm run seed --workspace=packages/prisma"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
