# Copy to .env.development / .env.staging / .env.production — never commit the real file.
# Variable names are identical across environments; only values differ (SRS Part J.1.1).

NODE_ENV=development

# Port the Express server binds inside its container (Nginx maps external ports in prod).
PORT=4000

# Prisma connection string — see packages/prisma/.env.example for the matching value.
DATABASE_URL="postgresql://commerceos:commerceos@localhost:5432/commerceos?schema=public"

# Session storage, caching, and rate-limit counters (SRS Part 19.4 / Part F.5.1).
REDIS_URL="redis://localhost:6379"

# Signing secrets for the short-lived access token and longer-lived refresh token
# (SRS Part 19.4). Distinct per environment; rotate immediately if ever leaked (Part K.6).
JWT_ACCESS_SECRET="change-me-access-secret-in-production"
JWT_REFRESH_SECRET="change-me-refresh-secret-in-production"

# Media upload/transform credentials (SRS Part 5.3) — product images, theme assets, CMS media.
CLOUDINARY_URL="cloudinary://change-me-api-key:change-me-api-secret@change-me-cloud-name"

# V1 SMS notification channel credentials (SRS Part 17).
SMS_PROVIDER_API_KEY="change-me-sms-provider-key"

# Comma-separated allow-list of this environment's own frontend origins — never a
# wildcard in staging or production (SRS Part J.1.1).
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Root domain used to resolve per-store Storefront subdomains (SRS Part 5.1).
APP_BASE_DOMAIN="commerceos.app"

# Store Dashboard / Admin Panel origins, used to build the password-reset
# link (SRS Part D.1.5) - which one depends on the account's role, so a
# Master Administrator's reset link opens the Admin Panel, not the Store
# Dashboard.
STORE_DASHBOARD_URL="http://localhost:5174"
ADMIN_PANEL_URL="http://localhost:5173"

# Storefront origin, used to build a store's public URL (storeName + "/" +
# slug) for approval/reactivation emails.
STOREFRONT_URL="http://localhost:5175"

# Shared secret required to create a new Master Administrator account via
# POST /api/auth/admin-signup (SRS Part 4/20.1) - never a public/open signup.
# Set a real random value in your own .env; this example value is dev-only.
ADMIN_SETUP_KEY="change-me-admin-setup-key"

# Merchant verification workflow - outbound email (lib/email.ts). Leave
# EMAIL_HOST/EMAIL_USER/EMAIL_PASSWORD unset in local dev and the server
# auto-provisions a fresh (throwaway, per-restart) Ethereal test inbox at
# startup. For a STABLE dev inbox you can log into anytime at
# https://ethereal.email, create a free Ethereal account there and set all
# three (plus EMAIL_PORT/EMAIL_FROM) below - same "smtp.ethereal.email":587
# host either way. Point these at Mailtrap or a real provider (e.g. Brevo)
# the same way when you're ready.
EMAIL_HOST="smtp.ethereal.email"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="CommerceOS <no-reply@commerceos.dev>"

# Where "New Store Verification Requires Review" notifications are sent
# (email.service.ts's sendAdminVerificationSubmittedEmail).
ADMIN_EMAIL="admin@commerceos.dev"
